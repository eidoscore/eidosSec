FROM python:3.11-slim

WORKDIR /app

# Install FastAPI, uvicorn and Docker CLI for fallback (static binary for reliability)
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-24.0.5.tgz | tar xvz --strip-components=1 -C /usr/local/bin/ docker/docker && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn[standard]==0.27.0 \
    docker==7.0.0

# Copy monitoring API
COPY status-api.py .

# Create data directory
RUN mkdir -p /app/data

EXPOSE 9000

CMD ["python", "status-api.py"]
