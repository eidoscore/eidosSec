FROM python:3.11-slim

WORKDIR /app

# Install FastAPI, uvicorn and Docker CLI for fallback
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://get.docker.com -o get-docker.sh && \
    sh get-docker.sh --docker-ca-path /tmp && \
    rm get-docker.sh && \
    pip install --no-cache-dir \
    fastapi==0.109.0 \
    uvicorn[standard]==0.27.0 \
    docker==7.0.0

# Copy monitoring API
COPY status-api.py .

# Create data directory
RUN mkdir -p /app/data

EXPOSE 9000

CMD ["python", "status-api.py"]
